# ══════════════════════════════════════════════
#   Facebook → Telegram Bot — Environment Config
# ══════════════════════════════════════════════

# ১. Telegram Bot Token (BotFather থেকে নাও)
BOT_TOKEN=your_bot_token_here

# ২. Telegram Channel ID
#    Public channel: @mychannel
#    Private channel: -1001234567890
CHANNEL_ID=@your_channel_here

# ৩. Owner Telegram User ID (তোমার নিজের ID)
#    https://t.me/userinfobot থেকে ID নাও
OWNER_IDS=123456789

# ৪. Admin Telegram User IDs (কমা দিয়ে আলাদা করো)
ADMIN_IDS=123456789,987654321

# ৫. Fetch Interval (মিনিটে)
FETCH_INTERVAL_MINUTES=30

# ৬. Facebook Graph API Access Token (STRONGLY RECOMMENDED)
#    এটা থাকলে পোস্ট fetch অনেক বেশি নির্ভরযোগ্য হয়।
#    কীভাবে পাবে:
#    ১. https://developers.facebook.com/ → My Apps → Create App
#    ২. Facebook Login → Pages permission যোগ করো
#    ৩. Graph API Explorer থেকে Page Access Token নাও
#    ৪. Token Debugger দিয়ে Long-lived token বানাও
FB_ACCESS_TOKEN=your_facebook_page_access_token_here

# ৭. Render Webhook URL
WEBHOOK_URL=https://your-app-name.onrender.com

# ৮. Port (Render auto-set করে)
PORT=8080
